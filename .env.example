# Copiare come .env (ignorato da git) o esportare a mano.

# Cache: senza REDIS_URL l'endpoint /data/cached si comporta come /data/nocache.
# Valore da un'istanza Azure Cache for Redis creata via terraform/ (vedi README):
REDIS_URL=rediss://:<redis_primary_access_key>@<redis_hostname>:<redis_ssl_port>/0

# Sorgente dati: senza DATABASE_URL l'app usa un file SQLite locale (./catalog.db).
# Valore da un'istanza Azure Database for PostgreSQL creata via terraform/database.tf:
DATABASE_URL=postgresql+psycopg2://<postgres_admin_username>:<password>@<postgres_fqdn>:5432/<postgres_database_name>?sslmode=require
